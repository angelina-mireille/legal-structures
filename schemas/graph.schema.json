{
  "$defs": {
    "ControlsEdge": {
      "additionalProperties": false,
      "description": "One entity controls another; means describes the fact.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "from": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "controls",
          "title": "Kind",
          "type": "string"
        },
        "means": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Means",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "evidence",
        "kind",
        "means"
      ],
      "title": "ControlsEdge",
      "type": "object"
    },
    "DatasetNode": {
      "additionalProperties": false,
      "description": "A dataset.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "dataset",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "evidence"
      ],
      "title": "DatasetNode",
      "type": "object"
    },
    "DerivedFromEdge": {
      "additionalProperties": false,
      "description": "A model built from another model by the stated method.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "from": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "derived_from",
          "title": "Kind",
          "type": "string"
        },
        "method": {
          "enum": [
            "fine_tune",
            "continued_pretraining",
            "quantize",
            "prune",
            "merge"
          ],
          "title": "Method",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "evidence",
        "kind",
        "method"
      ],
      "title": "DerivedFromEdge",
      "type": "object"
    },
    "DevelopedByEdge": {
