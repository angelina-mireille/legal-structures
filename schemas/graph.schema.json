        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "trained_on",
          "title": "Kind",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
