    "UsesCodeFromEdge": {
      "additionalProperties": false,
      "description": "A model or software that uses code from a software artefact.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "from": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "From",
