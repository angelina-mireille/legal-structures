          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "incorporates",
          "title": "Kind",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "evidence",
        "kind"
      ],
      "title": "IncorporatesEdge",
      "type": "object"
    },
    "ModelNode": {
      "additionalProperties": false,
      "description": "An AI model.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "model",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "evidence"
      ],
      "title": "ModelNode",
      "type": "object"
    },
    "OwnsEdge": {
      "additionalProperties": false,
      "description": "A direct stake of one entity in another. No aggregation or indirect calculation.",
      "properties": {
        "basis": {
          "enum": [
            "equity",
            "voting",
            "unknown"
          ],
          "title": "Basis",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "from": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "From",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "owns",
          "title": "Kind",
          "type": "string"
        },
        "percent": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "maximum": 100.0,
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Percent"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "evidence",
        "kind",
        "percent",
        "basis"
      ],
      "title": "OwnsEdge",
      "type": "object"
    },
    "SoftwareNode": {
      "additionalProperties": false,
      "description": "A software artefact.",
      "properties": {
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "form": {
          "enum": [
            "application",
            "service",
            "library",
            "source_code"
          ],
          "title": "Form",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "software",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "form",
        "evidence"
      ],
      "title": "SoftwareNode",
      "type": "object"
    },
