    "EntityNode": {
      "additionalProperties": false,
      "description": "An organisation or an individual (no name or identity fields).",
      "properties": {
        "entity_type": {
          "enum": [
            "organisation",
            "individual"
          ],
          "title": "Entity Type",
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/Evidence"
        },
        "id": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "const": "entity",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "kind",
        "entity_type",
        "evidence"
      ],
      "title": "EntityNode",
      "type": "object"
    },
    "Evidence": {
      "additionalProperties": false,
      "description": "Where a fact comes from and how strong it is.",
      "properties": {
        "grade": {
          "enum": [
            "declared",
            "documented",
            "verified",
            "suspected"
          ],
          "type": "string"
        },
        "recorded_by": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Recorded By",
          "type": "string"
        },
        "recorded_on": {
          "format": "date",
          "title": "Recorded On",
          "type": "string"
        },
        "source_ref": {
          "minLength": 1,
          "pattern": "\\S",
          "title": "Source Ref",
          "type": "string"
        }
      },
      "required": [
        "grade",
        "source_ref",
        "recorded_by",
        "recorded_on"
      ],
      "title": "Evidence",
      "type": "object"
    },
    "IncorporatesEdge": {
