        },
        "kind": {
          "const": "uses_code_from",
          "title": "Kind",
          "type": "string"
        },
        "to": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "id",
        "from",
        "to",
        "evidence",
        "kind"
      ],
      "title": "UsesCodeFromEdge",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A whole graph file. Whole-graph checks run on every construction.",
  "properties": {
    "edges": {
      "items": {
        "discriminator": {
          "mapping": {
            "controls": "#/$defs/ControlsEdge",
            "derived_from": "#/$defs/DerivedFromEdge",
            "developed_by": "#/$defs/DevelopedByEdge",
            "developed_with_tool": "#/$defs/DevelopedWithToolEdge",
            "distilled_from": "#/$defs/DistilledFromEdge",
            "incorporates": "#/$defs/IncorporatesEdge",
            "owns": "#/$defs/OwnsEdge",
            "trained_on": "#/$defs/TrainedOnEdge",
            "trained_on_output_of": "#/$defs/TrainedOnOutputOfEdge",
            "uses_code_from": "#/$defs/UsesCodeFromEdge"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/DerivedFromEdge"
          },
          {
            "$ref": "#/$defs/DistilledFromEdge"
          },
          {
            "$ref": "#/$defs/TrainedOnOutputOfEdge"
          },
          {
            "$ref": "#/$defs/TrainedOnEdge"
          },
          {
            "$ref": "#/$defs/UsesCodeFromEdge"
          },
          {
            "$ref": "#/$defs/DevelopedWithToolEdge"
          },
          {
            "$ref": "#/$defs/IncorporatesEdge"
          },
          {
            "$ref": "#/$defs/DevelopedByEdge"
          },
          {
            "$ref": "#/$defs/OwnsEdge"
          },
          {
            "$ref": "#/$defs/ControlsEdge"
          }
        ]
      },
      "title": "Edges",
      "type": "array"
    },
    "graph_id": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "title": "Graph Id",
      "type": "string"
    },
    "nodes": {
      "items": {
        "discriminator": {
          "mapping": {
            "dataset": "#/$defs/DatasetNode",
            "entity": "#/$defs/EntityNode",
            "model": "#/$defs/ModelNode",
            "software": "#/$defs/SoftwareNode"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/EntityNode"
          },
          {
            "$ref": "#/$defs/ModelNode"
          },
          {
            "$ref": "#/$defs/DatasetNode"
          },
          {
            "$ref": "#/$defs/SoftwareNode"
          }
        ]
      },
      "title": "Nodes",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "graph_id",
    "nodes",
    "edges"
  ],
  "title": "Graph",
  "type": "object"
}
